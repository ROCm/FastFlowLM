<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX v5 source for the flm installer.
  Ports src/inno/flm.iss (Inno Setup) to an MSI package.

  Build (from src/wix):
    wix build Package.wxs -arch x64 -ext WixToolset.UI.wixext -out flm-setup.msi

  Not ported 1:1 from flm.iss:
    - The interactive "model storage location" / "server port" wizard pages are
      not reproduced. FLM_MODEL_PATH and FLM_SERVE_PORT are written with the
      same defaults Inno used (%USERPROFILE%\.flm and 52625) but are not
      prompted for during install.
    - The desktop shortcuts ("flm run" / "flm serve") are an opt-in MSI
      feature (Level="1000", not installed by default) instead of an
      unchecked wizard checkbox, since there is no custom UI here to host one.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <?define SourceDir = "..\inno"?>
  <?define XclbinsDir = "..\xclbins"?>

  <Package Name="flm"
           Manufacturer="FastFlowLM"
           Version="1.0.5"
           UpgradeCode="5A5B2872-1E63-4934-9F57-088554CF4959"
           Language="1033"
           Scope="perMachine"
           Compressed="yes">

    <SummaryInformation Description="flm installer" Manufacturer="FastFlowLM" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of flm is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon.ico" SourceFile="$(SourceDir)\logo.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://www.fastflowlm.com" />

    <WixVariable Id="WixUILicenseRtf" Value="$(SourceDir)\terms.rtf" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <ui:WixUI Id="WixUI_InstallDir" />

    <!-- Directory layout -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="flm">
        <Directory Id="XCLBINSFOLDER" Name="xclbins" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="flm" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <!-- Environment: FLM_MODEL_PATH, FLM_SERVE_PORT, PATH -->
    <!-- Attached to the main exe's component so it is set/removed with install/uninstall. -->

    <!-- Features -->
    <Feature Id="MainFeature" Title="flm" Level="1">
      <ComponentGroupRef Id="MainComponents" />
      <ComponentGroupRef Id="XclbinsComponents" />
      <ComponentGroupRef Id="ApplicationShortcuts" />
    </Feature>

    <Feature Id="DesktopShortcutsFeature" Title="Desktop shortcuts" Level="1000">
      <ComponentGroupRef Id="DesktopShortcuts" />
    </Feature>

    <ComponentGroup Id="MainComponents" Directory="INSTALLFOLDER">

      <Component Id="Comp_flm.exe" Guid="*">
        <File Id="File_flm.exe" Source="$(SourceDir)\flm.exe" KeyPath="yes" />
        <Environment Id="Env_Path" Name="PATH" Value="[INSTALLFOLDER]" Part="last" Action="set" System="yes" Permanent="no" />
        <Environment Id="Env_ModelPath" Name="FLM_MODEL_PATH" Value="%USERPROFILE%\.flm" Action="set" System="yes" Permanent="no" />
        <Environment Id="Env_ServePort" Name="FLM_SERVE_PORT" Value="52625" Action="set" System="yes" Permanent="no" />
      </Component>

      <Component Id="Comp_libcurl.dll" Guid="*">
        <File Id="File_libcurl.dll" Source="$(SourceDir)\libcurl.dll" KeyPath="yes" />
      </Component>
      <Component Id="Comp_llama_npu.dll" Guid="*">
        <File Id="File_llama_npu.dll" Source="$(SourceDir)\llama_npu.dll" KeyPath="yes" />
      </Component>
      <Component Id="Comp_gemma_npu.dll" Guid="*">
        <File Id="File_gemma_npu.dll" Source="$(SourceDir)\gemma_npu.dll" KeyPath="yes" />
      </Component>
      <Component Id="Comp_gemma_text_npu.dll" Guid="*">
        <File Id="File_gemma_text_npu.dll" Source="$(SourceDir)\gemma_text_npu.dll" KeyPath="yes" />
      </Component>
      <Component Id="Comp_gemma_embedding.dll" Guid="*">
        <File Id="File_gemma_embedding.dll" Source="$(SourceDir)\gemma_embedding.dll" KeyPath="yes" />
      </Component>
      <Component Id="Comp_gpt_oss_npu.dll" Guid="*">
        <File Id="File_gpt_oss_npu.dll" Source="$(SourceDir)\gpt_oss_npu.dll" KeyPath="yes" />
      </Component>
      <Component Id="Comp_lfm2_npu.dll" Guid="*">
        <File Id="File_lfm2_npu.dll" Source="$(SourceDir)\lfm2_npu.dll" KeyPath="yes" />
      </Component>
      <Component Id="Comp_phi4_npu.dll" Guid="*">
        <File Id="File_phi4_npu.dll" Source="$(SourceDir)\phi4_npu.dll" KeyPath="yes" />
      </Component>
      <Component Id="Comp_qwen2_npu.dll" Guid="*">
        <File Id="File_qwen2_npu.dll" Source="$(SourceDir)\qwen2_npu.dll" KeyPath="yes" />
      </Component>
      <Component Id="Comp_qwen2vl_npu.dll" Guid="*">
        <File Id="File_qwen2vl_npu.dll" Source="$(SourceDir)\qwen2vl_npu.dll" KeyPath="yes" />
      </Component>
      <Component Id="Comp_qwen3_npu.dll" Guid="*">
        <File Id="File_qwen3_npu.dll" Source="$(SourceDir)\qwen3_npu.dll" KeyPath="yes" />
      </Component>
      <Component Id="Comp_qwen3vl_npu.dll" Guid="*">
        <File Id="File_qwen3vl_npu.dll" Source="$(SourceDir)\qwen3vl_npu.dll" KeyPath="yes" />
      </Component>
      <Component Id="Comp_qwen3vl_flash.dll" Guid="*">
        <File Id="File_qwen3vl_flash.dll" Source="$(SourceDir)\qwen3vl_flash.dll" KeyPath="yes" />
      </Component>
      <Component Id="Comp_qwen3_5vl_npu.dll" Guid="*">
        <File Id="File_qwen3_5vl_npu.dll" Source="$(SourceDir)\qwen3_5vl_npu.dll" KeyPath="yes" />
      </Component>
      <Component Id="Comp_qwen3_5_omni_npu.dll" Guid="*">
        <File Id="File_qwen3_5_omni_npu.dll" Source="$(SourceDir)\qwen3_5_omni_npu.dll" KeyPath="yes" />
      </Component>
      <Component Id="Comp_qwen3_6_moe_npu.dll" Guid="*">
        <File Id="File_qwen3_6_moe_npu.dll" Source="$(SourceDir)\qwen3_6_moe_npu.dll" KeyPath="yes" />
      </Component>
      <Component Id="Comp_nanbeige_npu.dll" Guid="*">
        <File Id="File_nanbeige_npu.dll" Source="$(SourceDir)\nanbeige_npu.dll" KeyPath="yes" />
      </Component>
      <Component Id="Comp_gemma4e_npu.dll" Guid="*">
        <File Id="File_gemma4e_npu.dll" Source="$(SourceDir)\gemma4e_npu.dll" KeyPath="yes" />
      </Component>
      <Component Id="Comp_gemma4e_flash.dll" Guid="*">
        <File Id="File_gemma4e_flash.dll" Source="$(SourceDir)\gemma4e_flash.dll" KeyPath="yes" />
      </Component>
      <Component Id="Comp_gemma4e_12b_npu.dll" Guid="*">
        <File Id="File_gemma4e_12b_npu.dll" Source="$(SourceDir)\gemma4_12b_npu.dll" KeyPath="yes" />
      </Component>
      <Component Id="Comp_hunyuan_npu.dll" Guid="*">
        <File Id="File_hunyuan_npu.dll" Source="$(SourceDir)\hunyuan_npu.dll" KeyPath="yes" />
      </Component>
      <Component Id="Comp_lm_head.dll" Guid="*">
        <File Id="File_lm_head.dll" Source="$(SourceDir)\lm_head.dll" KeyPath="yes" />
      </Component>
      <Component Id="Comp_dequant.dll" Guid="*">
        <File Id="File_dequant.dll" Source="$(SourceDir)\dequant.dll" KeyPath="yes" />
      </Component>
      <Component Id="Comp_whisper_npu.dll" Guid="*">
        <File Id="File_whisper_npu.dll" Source="$(SourceDir)\whisper_npu.dll" KeyPath="yes" />
      </Component>
      <Component Id="Comp_gemm.dll" Guid="*">
        <File Id="File_gemm.dll" Source="$(SourceDir)\gemm.dll" KeyPath="yes" />
      </Component>
      <Component Id="Comp_msvcp140.dll" Guid="*">
        <File Id="File_msvcp140.dll" Source="$(SourceDir)\msvcp140.dll" KeyPath="yes" />
      </Component>
      <Component Id="Comp_q4_npu_eXpress.dll" Guid="*">
        <File Id="File_q4_npu_eXpress.dll" Source="$(SourceDir)\q4_npu_eXpress.dll" KeyPath="yes" />
      </Component>
      <Component Id="Comp_mha.dll" Guid="*">
        <File Id="File_mha.dll" Source="$(SourceDir)\mha.dll" KeyPath="yes" />
      </Component>
      <Component Id="Comp_vcruntime140.dll" Guid="*">
        <File Id="File_vcruntime140.dll" Source="$(SourceDir)\vcruntime140.dll" KeyPath="yes" />
      </Component>
      <Component Id="Comp_vcruntime140_1.dll" Guid="*">
        <File Id="File_vcruntime140_1.dll" Source="$(SourceDir)\vcruntime140_1.dll" KeyPath="yes" />
      </Component>
      <Component Id="Comp_abseil_dll.dll" Guid="*">
        <File Id="File_abseil_dll.dll" Source="$(SourceDir)\abseil_dll.dll" KeyPath="yes" />
      </Component>
      <Component Id="Comp_avcodec_61.dll" Guid="*">
        <File Id="File_avcodec_61.dll" Source="$(SourceDir)\avcodec-61.dll" KeyPath="yes" />
      </Component>
      <Component Id="Comp_avdevice_61.dll" Guid="*">
        <File Id="File_avdevice_61.dll" Source="$(SourceDir)\avdevice-61.dll" KeyPath="yes" />
      </Component>
      <Component Id="Comp_avfilter_10.dll" Guid="*">
        <File Id="File_avfilter_10.dll" Source="$(SourceDir)\avfilter-10.dll" KeyPath="yes" />
      </Component>
      <Component Id="Comp_avformat_61.dll" Guid="*">
        <File Id="File_avformat_61.dll" Source="$(SourceDir)\avformat-61.dll" KeyPath="yes" />
      </Component>
      <Component Id="Comp_avutil_59.dll" Guid="*">
        <File Id="File_avutil_59.dll" Source="$(SourceDir)\avutil-59.dll" KeyPath="yes" />
      </Component>
      <Component Id="Comp_libprotobuf_lite.dll" Guid="*">
        <File Id="File_libprotobuf_lite.dll" Source="$(SourceDir)\libprotobuf-lite.dll" KeyPath="yes" />
      </Component>
      <Component Id="Comp_libprotobuf.dll" Guid="*">
        <File Id="File_libprotobuf.dll" Source="$(SourceDir)\libprotobuf.dll" KeyPath="yes" />
      </Component>
      <Component Id="Comp_libprotoc.dll" Guid="*">
        <File Id="File_libprotoc.dll" Source="$(SourceDir)\libprotoc.dll" KeyPath="yes" />
      </Component>
      <Component Id="Comp_swresample_5.dll" Guid="*">
        <File Id="File_swresample_5.dll" Source="$(SourceDir)\swresample-5.dll" KeyPath="yes" />
      </Component>
      <Component Id="Comp_swscale_8.dll" Guid="*">
        <File Id="File_swscale_8.dll" Source="$(SourceDir)\swscale-8.dll" KeyPath="yes" />
      </Component>
      <Component Id="Comp_zlib1.dll" Guid="*">
        <File Id="File_zlib1.dll" Source="$(SourceDir)\zlib1.dll" KeyPath="yes" />
      </Component>
      <Component Id="Comp_libfftw3_3.dll" Guid="*">
        <File Id="File_libfftw3_3.dll" Source="$(SourceDir)\libfftw3-3.dll" KeyPath="yes" />
      </Component>
      <Component Id="Comp_libfftw3f_3.dll" Guid="*">
        <File Id="File_libfftw3f_3.dll" Source="$(SourceDir)\libfftw3f-3.dll" KeyPath="yes" />
      </Component>
      <Component Id="Comp_libfftw3l_3.dll" Guid="*">
        <File Id="File_libfftw3l_3.dll" Source="$(SourceDir)\libfftw3l-3.dll" KeyPath="yes" />
      </Component>

      <Component Id="Comp_logo.ico" Guid="*">
        <File Id="File_logo.ico" Source="$(SourceDir)\logo.ico" KeyPath="yes" />
      </Component>
      <Component Id="Comp_model_list.json" Guid="*">
        <File Id="File_model_list.json" Source="$(SourceDir)\model_list.json" KeyPath="yes" />
      </Component>
      <Component Id="Comp_model_info.json" Guid="*">
        <File Id="File_model_info.json" Source="$(SourceDir)\model_info.json" KeyPath="yes" />
      </Component>

    </ComponentGroup>

    <!-- xclbins\* recursively, mirrors flm.iss's recursesubdirs Source entry -->
    <ComponentGroup Id="XclbinsComponents" Directory="XCLBINSFOLDER">
      <Files Include="$(XclbinsDir)\**" />
    </ComponentGroup>

    <!-- Start Menu shortcut: always installed -->
    <ComponentGroup Id="ApplicationShortcuts" Directory="ApplicationProgramsFolder">
      <Component Id="Comp_StartMenuShortcut" Guid="*">
        <Shortcut Id="StartMenuShortcut"
                  Name="flm"
                  Description="Launch flm"
                  Target="[INSTALLFOLDER]flm.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon.ico" />
        <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKLM" Key="Software\FastFlowLM\flm" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Desktop shortcuts: opt-in feature (DesktopShortcutsFeature, Level 1000) -->
    <ComponentGroup Id="DesktopShortcuts" Directory="DesktopFolder">
      <Component Id="Comp_DesktopShortcutRun" Guid="*">
        <Shortcut Id="DesktopShortcutRun"
                  Name="flm run"
                  Description="Launch flm with llama3.2:1b model"
                  Target="[%ComSpec]"
                  Arguments="/K &quot;[INSTALLFOLDER]flm.exe&quot; run llama3.2:1b"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon.ico" />
        <RegistryValue Root="HKLM" Key="Software\FastFlowLM\flm" Name="DesktopShortcutRun" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="Comp_DesktopShortcutServe" Guid="*">
        <Shortcut Id="DesktopShortcutServe"
                  Name="flm serve"
                  Description="Launch flm in serve mode"
                  Target="[%ComSpec]"
                  Arguments="/K &quot;[INSTALLFOLDER]flm.exe&quot; serve"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon.ico" />
        <RegistryValue Root="HKLM" Key="Software\FastFlowLM\flm" Name="DesktopShortcutServe" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

  </Package>
</Wix>
