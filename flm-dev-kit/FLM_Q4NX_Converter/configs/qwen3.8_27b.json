{
    "q4nx_config": {
        "row_block_size": 32,
        "col_block_size": 256,
        "parallel_size": 32,
        "keep_block_in_2D": true
    },
    "_vision_config_comment": [
        "The 27B vision tower does NOT use the blocked qwen3.5 vision layout.",
        "FLM_Xclbin/Qwen3_8/vision_mm streams w straight out of DDR as plain",
        "row-major (N, K) bf16 (see its seq_gen.hpp), so the converter only has",
        "to zero-pad -- there is no (mm_n mm_k) re-order.",
        "vision_MM_K is the k tile, 384 in both designs.",
        "vision_MM_N is the array N tile, n * 8 columns: design A has n=48 so",
        "384, design B has n=128 so 1024.  merger.linear_fc2 is the one layer on",
        "design B, hence the override -- padding its 5120 outputs up to a",
        "multiple of 384 would give 5376, which design B cannot tile.",
        "Kept in step with FLM_Xclbin/Qwen3_8/vision_mm/iron/mm_config.py."
    ],
    "vision_config": {
        "vision_MM_K": 384,
        "vision_MM_N": 384,
        "vision_MM_N_override": {
            "merger.linear_fc2": 1024
        }
    },
    "default_tensor_type": "Q4_K",
