            "default_tensor_type": "BF16"
        },
        "vision_patch_embd_bias": {
            "gguf_name": "v.patch_embd.bias",
            "q4nx_name": "model.vision_embedder.patch_dense.bias",
            "default_tensor_type": "BF16"
        },
        "vision_patch_ln1_weight":{
            "gguf_name": "v.patch_norm.1.weight",
