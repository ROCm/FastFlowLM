            "default_tensor_type": "BF16"            
        },
        "vision_patch_ln1_bias":{
            "gguf_name": "v.patch_norm.1.bias",
            "q4nx_name": "model.vision_embedder.patch_ln1.bias",
            "default_tensor_type": "BF16"            
        },
        "vision_patch_ln2_weight":{
            "gguf_name": "v.patch_norm.2.weight",
            "q4nx_name": "model.vision_embedder.patch_ln2.weight",
            "default_tensor_type": "BF16"            
        },
        "vision_patch_ln2_bias":{
            "gguf_name": "v.patch_norm.2.bias",
            "q4nx_name": "model.vision_embedder.patch_ln2.bias",
            "default_tensor_type": "BF16"            
        },
        "vision_pos_norm_weight":{
            "gguf_name": "v.patch_norm.3.weight",
            "q4nx_name": "model.vision_embedder.pos_norm.weight",
            "default_tensor_type": "BF16"            
        },
        "vision_pos_norm_bias":{
            "gguf_name": "v.patch_norm.3.bias",
            "q4nx_name": "model.vision_embedder.pos_norm.bias",
            "default_tensor_type": "BF16"            
        },


        "audio_input_proj_weight" :{
            "gguf_name": "mm.a.input_projection.weight",
            "q4nx_name": "model.embed_audio.embedding_projection.weight",
            "default_tensor_type": "BF16"
        }
