        },
        "ffn_norm": {
            "gguf_name": "blk.{bid}.ffn_norm.weight",
            "q4nx_name": "model.layers.{bid}.pre_feedforward_layernorm.weight",
            "default_tensor_type": "BF16"            
        },
        "post_ffn_norm":{
            "gguf_name": "blk.{bid}.post_ffw_norm.weight",
            "q4nx_name": "model.layers.{bid}.post_feedforward_layernorm.weight",
            "default_tensor_type": "BF16"                        
        },
        "model_final_norm": {
            "gguf_name": "output_norm.weight",
            "q4nx_name": "model.norm.weight",
            "default_tensor_type": "BF16"             
        },
        "rope_freqs": {
            "gguf_name": "rope_freqs.weight",
