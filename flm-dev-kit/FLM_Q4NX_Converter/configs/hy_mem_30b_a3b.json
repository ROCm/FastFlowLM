{
    "q4nx_config": {
        "row_block_size": 32,
        "col_block_size": 256,
        "parallel_size": 32,
        "keep_block_in_2D": true
    },
    "default_tensor_type": "Q4_K",
    "name_map": {
        "embedding": {
            "gguf_name": "token_embd.weight",
            "q4nx_name": "model.embed_tokens.weight",
            "default_tensor_type": "BF16"
        },
        "q_proj": {
            "gguf_name": "blk.{bid}.attn_q.weight",
            "q4nx_name": "model.layer.{bid}.self_attn.q_proj.weight"
        },
        "q_norm": {
            "gguf_name": "blk.{bid}.attn_q_norm.weight",
            "q4nx_name": "model.layer.{bid}.self_attn.q_norm.weight",
            "default_tensor_type": "BF16"
        },
        "k_proj": {
            "gguf_name": "blk.{bid}.attn_k.weight",
            "q4nx_name": "model.layer.{bid}.self_attn.k_proj.weight"
        },
        "k_norm": {
            "gguf_name": "blk.{bid}.attn_k_norm.weight",
            "q4nx_name": "model.layer.{bid}.self_attn.k_norm.weight",
            "default_tensor_type": "BF16"
        },
        "v_proj": {
            "gguf_name": "blk.{bid}.attn_v.weight",
            "q4nx_name": "model.layer.{bid}.self_attn.v_proj.weight"
        },
        "o_proj": {
            "gguf_name": "blk.{bid}.attn_output.weight",
            "q4nx_name": "model.layer.{bid}.self_attn.o_proj.weight"
        },

        "pre_attn_norm": {
            "gguf_name": "blk.{bid}.attn_norm.weight",
            "q4nx_name": "model.layer.{bid}.input_layernorm.weight",
            "default_tensor_type": "BF16"
        },
        "post_attn_norm": {
            "gguf_name": "blk.{bid}.ffn_norm.weight",
            "q4nx_name": "model.layer.{bid}.post_attention_layernorm.weight",
            "default_tensor_type": "BF16"
        },

        "dense_up_proj": {
            "gguf_name": "blk.{bid}.ffn_up.weight",
            "q4nx_name": "model.layer.{bid}.mlp.up_proj.weight"
        },
        "dense_gate_proj": {
            "gguf_name": "blk.{bid}.ffn_gate.weight",
            "q4nx_name": "model.layer.{bid}.mlp.gate_proj.weight"
        },
        "dense_down_proj": {
            "gguf_name": "blk.{bid}.ffn_down.weight",
            "q4nx_name": "model.layer.{bid}.mlp.down_proj.weight"
        },

        "router": {
            "gguf_name": "blk.{bid}.ffn_gate_inp.weight",
            "q4nx_name": "model.layer.{bid}.moe_router.weight",
            "default_tensor_type": "BF16"
        },
        "router_expert_bias": {
            "gguf_name": "blk.{bid}.exp_probs_b",
            "q4nx_name": "model.layer.{bid}.moe_expert_bias",
            "default_tensor_type": "F32"
        },

        "up_exp_proj": {
            "gguf_name": "blk.{bid}.ffn_up_exps.weight",
            "q4nx_name": "model.layer.{bid}.mlp.up_exps_proj.weight"
        },
        "up_share_exp_proj": {
            "gguf_name": "blk.{bid}.ffn_up_shexp.weight",
            "q4nx_name": "model.layer.{bid}.mlp.share_up_exps_proj.weight"
        },
        "gate_exp_proj": {
            "gguf_name": "blk.{bid}.ffn_gate_exps.weight",
            "q4nx_name": "model.layer.{bid}.mlp.gate_exps_proj.weight"
        },
        "gate_share_exp_proj": {
            "gguf_name": "blk.{bid}.ffn_gate_shexp.weight",
            "q4nx_name": "model.layer.{bid}.mlp.share_gate_exps_proj.weight"
        },
        "down_exp_proj": {
            "gguf_name": "blk.{bid}.ffn_down_exps.weight",
            "q4nx_name": "model.layer.{bid}.mlp.down_exps_proj.weight"
        },
        "down_share_exp_proj": {
            "gguf_name": "blk.{bid}.ffn_down_shexp.weight",
            "q4nx_name": "model.layer.{bid}.mlp.share_down_exps_proj.weight"
        },

        "model_final_norm": {
            "gguf_name": "output_norm.weight",
            "q4nx_name": "model.norm.weight",
            "default_tensor_type": "BF16"
        },
        "lm_head": {
            "gguf_name": "output.weight",
            "q4nx_name": "lm_head.weight",
            "default_tensor_type": "Q8_0"
        }
    }
}
